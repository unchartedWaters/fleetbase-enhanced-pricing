{
    "name": "unchartedwaters/enhanced-pricing-api",
    "version": "0.0.1",
    "description": "Price Fleet-Ops orders from pricing profiles: per-customer rate cards and overrides, fees, subtotal fees and manual charges.",
    "keywords": [
        "fleetbase",
        "fleetbase-extension",
        "pricing",
        "rates",
        "invoice",
        "fleet-ops"
    ],
    "license": "AGPL-3.0-or-later",
    "authors": [
        {
            "name": "unchartedWaters"
        }
    ],
    "require": {
        "php": "^8.2",
        "brick/math": "^0.12",
        "fleetbase/core-api": "^1.6"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.34.1",
        "nunomaduro/collision": "^5.11.0|^6.4.0",
        "pestphp/pest": "^1.22.6",
        "phpstan/phpstan": "^2.3.1",
        "symfony/var-dumper": "^5.4.29",
        "symfony/yaml": "^6.4|^7.0"
    },
    "autoload": {
        "psr-4": {
            "Fleetbase\\EnhancedPricing\\": "server/src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Fleetbase\\EnhancedPricing\\Tests\\": "server/tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "extra": {
        "laravel": {
            "providers": [
                "Fleetbase\\EnhancedPricing\\Providers\\EnhancedPricingServiceProvider"
            ]
        }
    },
    "config": {
        "vendor-dir": "./server_vendor",
        "sort-packages": true,
        "preferred-install": "dist",
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        },
        "policy": {
            "advisories": {
                "ignore-id": {
                    "PKSA-zwc5-qtrz-zm1n": "Inherited CVE-2026-48019 via fleetbase/core-api ^1.6 (newest 1.6.68 still requires illuminate/notifications 9 or 10). Not fixable in this package."
                }
            }
        },
        "platform": {
            "php": "8.2.0"
        }
    },
    "scripts": {
        "lint": "php-cs-fixer fix -v --dry-run",
        "test:lint": "php-cs-fixer fix -v --dry-run",
        "test:types": "phpstan analyse --ansi --memory-limit=1G",
        "test:unit": "php scripts/pest-runner.php --colors=always",
        "test": [
            "@test:lint",
            "@test:types",
            "@test:unit"
        ]
    }
}
