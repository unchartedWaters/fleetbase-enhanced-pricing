<section class="overflow-x-auto rounded-lg border border-gray-200 bg-white p-4 shadow-sm dark:border-gray-700 dark:bg-gray-800" data-test-quote>
    <div class="table-wrapper table-fluid">
        <table class="w-full text-sm">
            <thead>
                <tr>
                    <th class="px-3 py-2 text-left">{{t "enhanced-pricing.console.preview.line"}}</th>
                    <th class="px-3 py-2 text-left">{{t "enhanced-pricing.console.preview.billing-code"}}</th>
                    <th class="px-3 py-2 text-right">{{t "enhanced-pricing.console.preview.quantity"}}</th>
                    <th class="px-3 py-2 text-right">{{t "enhanced-pricing.console.preview.unit-amount"}}</th>
                    <th class="px-3 py-2 text-right">{{t "enhanced-pricing.console.preview.amount"}}</th>
                </tr>
            </thead>
            <tbody>
                {{#each @quote.lines as |line index|}}
                    <tr data-test-line={{index}}>
                        <td class="px-3 py-2">{{line.name}}</td>
                        <td class="px-3 py-2 font-mono text-xs" data-test-billing-code>
                            {{line.billing_code}}
                            {{#unless (eq line.billing_code line.product)}}
                                <span class="block text-gray-500 dark:text-gray-400" data-test-product>{{t "enhanced-pricing.console.preview.product"}} {{line.product}}</span>
                            {{/unless}}
                        </td>
                        <td class="px-3 py-2 text-right">{{line.quantity}}</td>
                        <td class="px-3 py-2 text-right">{{pricing-money line.unit_amount @quote.currency}}</td>
                        <td class="px-3 py-2 text-right" data-test-amount>{{pricing-money line.amount @quote.currency}}</td>
                    </tr>
                {{/each}}
            </tbody>
            <tfoot>
                <tr>
                    <td class="px-3 py-2 font-semibold" colspan="4">{{t "enhanced-pricing.console.preview.total"}}</td>
                    <td class="px-3 py-2 text-right font-semibold" data-test-total>{{pricing-money @quote.total @quote.currency}}</td>
                </tr>
            </tfoot>
        </table>
    </div>
    {{#if @quote.notes.length}}
        <ul class="mt-3 list-disc pl-5 text-sm text-gray-600 dark:text-gray-300" data-test-notes>
            {{#each @quote.notes as |note|}}
                <li>{{pricing-message note}}</li>
            {{/each}}
        </ul>
    {{/if}}
</section>
