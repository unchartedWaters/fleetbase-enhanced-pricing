<section class="rounded-lg border border-gray-200 bg-white p-4 shadow-sm dark:border-gray-700 dark:bg-gray-800" data-test-fee={{@fee.key}}>
    <header class="mb-2 flex items-baseline justify-between">
        <h3 class="text-base font-semibold text-gray-900 dark:text-white">{{@fee.name}}</h3>
        <span class="font-mono text-xs text-gray-500 dark:text-gray-400">{{@fee.path}}</span>
    </header>
    <p class="text-sm">
        {{t "enhanced-pricing.console.fees.today"}}
        <span class="font-semibold" data-test-current>{{this.current}}</span>
        {{#if @fee.current.effective_from}}
            <span class="text-xs text-gray-500 dark:text-gray-400">{{t "enhanced-pricing.console.fees.since" date=@fee.current.effective_from}}</span>
        {{/if}}
    </p>

    {{#if this.upcoming.length}}
        <ul class="mt-2 space-y-1 text-sm" data-test-upcoming>
            {{#each this.upcoming key="uuid" as |change|}}
                <li class="flex flex-wrap items-center gap-2" data-test-upcoming-change={{change.uuid}}>
                    <span>{{t "enhanced-pricing.console.value-from" value=change.shown date=change.effective_from}}</span>
                    <span class="text-xs text-gray-500 dark:text-gray-400">{{t "enhanced-pricing.console.fees.added-by-name" name=(or change.added_by.name (t "enhanced-pricing.console.unknown-person"))}}</span>
                    {{#if @onCancel}}
                        {{#if (eq this.confirmingCancel change.uuid)}}
                            <Button @size="xs" @type="danger" @text={{t "enhanced-pricing.console.fees.confirm-cancel"}} @onClick={{fn this.cancel change.uuid}} data-test-confirm-cancel />
                            <Button @size="xs" @text={{t "enhanced-pricing.console.fees.keep"}} @onClick={{fn this.askCancel null}} />
                        {{else}}
                            <Button @size="xs" @text={{t "enhanced-pricing.console.fees.cancel-change"}} @onClick={{fn this.askCancel change.uuid}} data-test-cancel />
                        {{/if}}
                    {{/if}}
                </li>
            {{/each}}
        </ul>
    {{/if}}

    {{#if this.overridden.length}}
        <div class="mt-3 rounded border border-yellow-300 bg-yellow-50 p-2 text-sm dark:border-yellow-700 dark:bg-yellow-950" data-test-overridden>
            {{t "enhanced-pricing.console.fees.overridden" count=this.overridden.length}}
            {{#each this.overridden key="uuid" as |customer index|}}{{if index ", "}}{{customer.name}} ({{customer.shown}}){{/each}}
        </div>
    {{/if}}

    {{#if @onSchedule}}
        <div class="mt-4 flex flex-wrap items-start gap-4 border-t border-gray-200 pt-3 dark:border-gray-700">
            <div data-test-new-value>
                <span class="mb-1 block text-xs font-semibold text-gray-700 dark:text-gray-200">{{t (if this.isPercent "enhanced-pricing.console.fees.new-percentage" "enhanced-pricing.console.fees.new-amount")}}</span>
                <Pricing::MoneyInput @value={{this.value}} @kind={{if this.isPercent "percent" "money"}} @currency={{@currency}} @onChange={{this.setValue}} @onError={{this.setError}} />
            </div>
            <label class="block text-xs font-semibold text-gray-700 dark:text-gray-200">
                {{t "enhanced-pricing.console.fees.effective-from"}}
                <input type="date" class="form-input form-input-sm mt-1 block w-48" value={{this.date}} data-test-new-date {{on "change" this.setDate}} />
            </label>
            <div class="self-end">
                <Button @type="primary" @text={{t "enhanced-pricing.console.fees.schedule"}} @isLoading={{this.sending}} @disabled={{this.cannotSchedule}} @onClick={{this.schedule}} data-test-schedule />
            </div>
        </div>
    {{/if}}

    {{#if this.large}}
        <div class="mt-3 rounded border border-yellow-300 bg-yellow-50 p-3 text-sm dark:border-yellow-700 dark:bg-yellow-950" role="alert" data-test-large-change>
            <Pricing::ProblemList @problems={{this.large}} @hidePath={{true}} />
            <p class="my-2">{{t "enhanced-pricing.console.fees.large-change" currency=@currency}}</p>
            <Button @type="warning" @text={{t "enhanced-pricing.console.fees.confirm-large-change"}} @isLoading={{this.sending}} @onClick={{this.confirmLarge}} data-test-confirm-large-change />
        </div>
    {{/if}}
    {{#if this.problems.length}}
        <div class="mt-2">
            <Pricing::ProblemList @problems={{this.problems}} @hidePath={{true}} />
        </div>
    {{/if}}
    {{#if this.failure}}
        <div class="mt-2 text-sm text-red-700 dark:text-red-300" role="alert"><Pricing::Refusal @refusal={{this.failure}} /></div>
    {{/if}}
</section>
